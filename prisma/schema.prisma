// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BracketStatus {
  SETUP
  NOMINATING
  SEEDING
  ACTIVE
  COMPLETE
}

enum NominationMode {
  OPEN
  DRAFT
}

enum BracketContentType {
  MOVIE
  CHARACTER
}

enum RoundStatus {
  PENDING
  VOTING_OPEN
  VOTING_CLOSED
  COMPLETE
}

enum MatchupStatus {
  PENDING
  OPEN
  CLOSED
  NEEDS_MANUAL_TIEBREAK
  RESOLVED
}

enum ResolutionMethod {
  SCORE
  TIEBREAK_CATEGORY
  COIN_FLIP
  REVOTE
}

enum VoterRole {
  VOTER
  ADMIN
}

model Bracket {
  id                    String         @id @default(cuid())
  slug                  String         @unique
  name                  String
  status                BracketStatus      @default(SETUP)
  nominationMode        NominationMode     @default(OPEN)
  contentType           BracketContentType @default(MOVIE)
  characterName         String? // set for CHARACTER brackets (e.g. "Batman") — the character is bracket-level, one per bracket, actors compete
  nominationCapPerVoter Int?
  poolTargetSize        Int?
  currentRound          Int?
  filterPersonIds       String? // JSON-encoded array of {id, name}
  filterCompanyIds      String? // JSON-encoded array of {id, name}
  filterKeywordIds      String? // JSON-encoded array of {id, name}
  filterCollectionIds   String? // JSON-encoded array of {id, name}
  filterGenreIds        String? // JSON-encoded array of TMDb genre ids
  filterYearMin         Int?
  filterYearMax         Int?
  autoAdvance           Boolean        @default(true)
  emailNotificationsEnabled Boolean    @default(false) // gates draft turn-reminder emails only — invites and login links always send
  archived              Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  categories Category[]
  movies     Movie[]
  voters     Voter[]
  seedVotes  SeedVote[]
  rounds     Round[]
  matchups   Matchup[]
  draftState DraftState?
}

model Category {
  id            String  @id @default(cuid())
  bracketId     String
  bracket       Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  key           String
  label         String
  order         Int
  isTiebreaker  Boolean @default(false)

  @@unique([bracketId, key])
}

// Despite the name, also holds CHARACTER-bracket nominees (an actor's
// portrayal) — tmdbId/title/posterUrl are reused for the actor's TMDb
// person id/name/profile photo rather than forking a parallel model, since
// bracket generation and every display component only ever operate on
// those two fields generically (see filmTmdbId/filmTitle/filmYear below
// for the optional representative-film context specific to that mode).
model Movie {
  id                 String   @id @default(cuid())
  bracketId          String
  bracket            Bracket  @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  tmdbId             Int
  title              String
  posterUrl          String?
  overview           String?
  voteAverage        Float?
  popularity         Float?
  releaseYear        Int?
  runtime            Int?
  trailerKey         String?
  filmTmdbId         Int? // CHARACTER brackets only: the optional representative film's TMDb id
  filmTitle          String?
  filmYear           Int?
  nominatedByVoterId String?
  nominatedByVoter   Voter?   @relation(fields: [nominatedByVoterId], references: [id])
  seed               Int?
  createdAt          DateTime @default(now())

  seedVotes       SeedVote[]
  matchupsAsA     Matchup[]  @relation("MovieA")
  matchupsAsB     Matchup[]  @relation("MovieB")
  matchupsAsWinner Matchup[] @relation("Winner")

  @@unique([bracketId, tmdbId])
}

model DraftState {
  id               String    @id @default(cuid())
  bracketId        String    @unique
  bracket          Bracket   @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  turnOrder        String // JSON-encoded array of voter IDs
  currentTurnIndex Int       @default(0)
  turnNotifiedAt   DateTime? // last time the current turn-holder was emailed about this turn
  updatedAt        DateTime  @updatedAt
}

model Person {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  avatar              String? // emoji preset, or a data: URI for an uploaded photo
  emailVerifiedAt     DateTime? // set once a magic-link login is completed
  loginTokenHash      String?   @unique // sha256 of the emailed token, never stored plain
  loginTokenExpiresAt DateTime?
  sessionVersion      Int       @default(0) // bumped on logout to invalidate outstanding session cookies
  isGlobalAdmin       Boolean   @default(false) // linked as an admin shortcut, bypassing ADMIN_PASSWORD
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  voters Voter[]
}

model Voter {
  id             String    @id @default(cuid())
  bracketId      String
  bracket        Bracket   @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  avatar         String? // emoji preset, or a data: URI for an uploaded photo
  email          String? // set only for voters the admin invited by email
  inviteToken    String?   @unique
  invitedAt      DateTime?
  personId       String? // links to a persistent cross-bracket Person, when one was linked
  person         Person?   @relation(fields: [personId], references: [id])
  role           VoterRole @default(VOTER) // ADMIN requires a linked, verified Person — see promoteVoter
  createdAt      DateTime  @default(now())

  nominatedMovies    Movie[]
  seedVotes          SeedVote[]
  votes              Vote[]
  roundConfirmations RoundConfirmation[]

  @@unique([bracketId, normalizedName])
  @@unique([bracketId, email])
}

model SeedVote {
  id        String  @id @default(cuid())
  bracketId String
  bracket   Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  voterId   String
  voter     Voter   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  score     Int

  @@unique([movieId, voterId])
}

model Round {
  id          String      @id @default(cuid())
  bracketId   String
  bracket     Bracket     @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  roundNumber Int
  status      RoundStatus @default(PENDING)
  closesAt    DateTime? // set once every invited voter has voted on every open matchup; null outside the review window — see lib/phase-transitions.ts

  matchups      Matchup[]
  confirmations RoundConfirmation[]

  @@unique([bracketId, roundNumber])
}

// A voter explicitly signaling "I'm done, don't wait on me" during a
// round's review window — once every invited voter has one of these for the
// current round, the round closes immediately instead of waiting out
// Round.closesAt. Cleared (all rows for the round deleted) whenever any
// voter edits a vote during the window, since the picks changed underneath
// whoever already confirmed.
model RoundConfirmation {
  id          String   @id @default(cuid())
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voterId     String
  voter       Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  confirmedAt DateTime @default(now())

  @@unique([roundId, voterId])
}

model Matchup {
  id               String            @id @default(cuid())
  bracketId        String
  bracket          Bracket           @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  roundId          String
  round            Round             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  position         Int
  movieAId         String?
  movieA           Movie?            @relation("MovieA", fields: [movieAId], references: [id])
  movieBId         String?
  movieB           Movie?            @relation("MovieB", fields: [movieBId], references: [id])
  isBye            Boolean           @default(false)
  status           MatchupStatus     @default(PENDING)
  winnerMovieId    String?
  winnerMovie      Movie?            @relation("Winner", fields: [winnerMovieId], references: [id])
  resolutionMethod ResolutionMethod?
  nextMatchupId    String?
  nextMatchup      Matchup?          @relation("Advancement", fields: [nextMatchupId], references: [id])
  previousMatchups Matchup[]         @relation("Advancement")
  nextMatchupSlot  String? // "A" | "B"

  votes Vote[]

  @@unique([bracketId, roundId, position])
}

model Vote {
  id            String  @id @default(cuid())
  matchupId     String
  matchup       Matchup @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  voterId       String
  voter         Voter   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  scoresMovieA  String // JSON-encoded { [categoryKey]: 1-5 }
  scoresMovieB  String // JSON-encoded { [categoryKey]: 1-5 }
  totalA        Int
  totalB        Int
  viaSwipeOnly  Boolean  @default(false) // true only if every score is still the raw swipe default — see swipeToScores in lib/swipe-vote.ts. Excluded when pre-filling a later matchup's baseline (app/b/[slug]/vote/page.tsx), since it was never a deliberate rating.
  createdAt     DateTime @default(now())

  @@unique([matchupId, voterId])
}
