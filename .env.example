# Postgres connection string. In Vercel this is auto-injected when you add a
# Postgres database under Storage. Locally, point it at a free Neon/Vercel
# Postgres branch — e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Shared admin password gate for /admin/* routes (not real auth, just a deterrent).
ADMIN_PASSWORD="changeme"

# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Used to email bracket invites, sent via your own Gmail account over SMTP.
# GMAIL_USER is the full address; GMAIL_APP_PASSWORD is a 16-character App
# Password (not your regular password) — requires 2-Step Verification on
# the account. Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
