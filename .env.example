# Postgres connection string. In Vercel this is auto-injected when you add a
# Postgres database under Storage. Locally, point it at a free Neon/Vercel
# Postgres branch — e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Shared admin password gate for /admin/* routes (not real auth, just a deterrent).
ADMIN_PASSWORD="changeme"

# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Used to email bracket invites, sent via your own Gmail account over SMTP.
# GMAIL_USER is the full address; GMAIL_APP_PASSWORD is a 16-character App
# Password (not your regular password) — requires 2-Step Verification on
# the account. Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Signs the person_id login session cookie — any long random string, keep it
# secret. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Authorizes Vercel Cron to hit /api/cron/turn-reminders (Vercel sends this
# as an Authorization: Bearer header automatically when the env var is set).
# Only needed in Vercel's project settings — Vercel Cron doesn't run in
# local dev, so this isn't required here; generate the same way as
# SESSION_SECRET.
CRON_SECRET=""

# AI avatar generation — a separate Google Cloud Run service running
# SD-Turbo on CPU (Vercel can't host that itself). See
# avatar-service/README.md for one-time deployment steps. Leave both unset
# to leave the feature off; the app works fine without it.
AVATAR_SERVICE_URL=""
AVATAR_SERVICE_SECRET=""
