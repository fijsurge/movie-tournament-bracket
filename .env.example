# Postgres connection string. In Vercel this is auto-injected when you add a
# Postgres database under Storage. Locally, point it at a free Neon/Vercel
# Postgres branch — e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Shared admin password gate for /admin/* routes (not real auth, just a deterrent).
ADMIN_PASSWORD="changeme"

# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Get a free key at https://resend.com/api-keys — used to email bracket
# invites. Without a verified domain in Resend, you can only send to the
# email address your Resend account itself is signed up with.
RESEND_API_KEY=""

# Optional — defaults to Resend's shared sandbox sender.
RESEND_FROM_EMAIL=""
